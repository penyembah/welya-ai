# Copy to .env.docker and fill in. Used by: docker compose -f docker-compose.prod.yml --env-file .env.docker up -d --build
# Never commit .env.docker (root .gitignore ignores .env.*).

# --- domains (Caddy issues Let's Encrypt certificates automatically; point DNS A records here first) ---
APP_DOMAIN=app.welya.biz.id
API_DOMAIN=api.welya.biz.id
ACME_EMAIL=you@example.com

# --- database ---
POSTGRES_USER=welya
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=welya

# --- api ---
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Comma-separated browser origins allowed to call the API
CORS_ORIGIN=https://app.welya.biz.id
# Public URL of the web app (used in emails and OAuth redirects)
APP_URL=https://app.welya.biz.id
API_PORT=4000
# ACCESS_TOKEN_TTL=15m
# SESSION_TTL_DAYS=30
# RATE_LIMIT_MAX=300

# --- web ---
# Public URL the browser uses to reach the API
PUBLIC_API_URL=https://api.welya.biz.id
WEB_PORT=8080

# --- AI (optional) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini

# --- email via Brevo SMTP (optional) ---
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Welya AI <noreply@welya.biz.id>

# --- Google OAuth (optional). Redirect URIs must match the Cloud Console exactly ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.welya.biz.id/auth/google/callback
GOOGLE_INTEGRATION_REDIRECT_URI=https://api.welya.biz.id/integrations/google/callback

# --- reminders ---
REMINDER_SCHEDULER_ENABLED=true
WEEKLY_REVIEW_DAY=0
WEEKLY_REVIEW_TIME=19:00
