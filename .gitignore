# Welya monorepo — root ignores (each app may add its own .gitignore)

# dependencies & builds
node_modules/
dist/
dist-ssr/
build/
.next/
out/
*.tsbuildinfo

# environment & secrets — never commit real keys; use the .env.example files
.env
.env.*
!.env.example
!.env.*.example
# public build-time config for the web/desktop bundle (no secrets)
!apps/web/.env.production
*.local

# runtime data
apps/api/uploads/
*.log
logs/
npm-debug.log*
yarn-*.log
pnpm-debug.log*

# databases / docker
*.sqlite
*.db
docker-compose.override.yml

# tauri / rust
apps/web/src-tauri/target/
apps/web/src-tauri/gen/schemas/
apps/web/src-tauri/Cargo.lock.bak

# editors & OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# generated by tooling
apps/landing/AGENTS.md
apps/landing/CLAUDE.md
.vercel/
coverage/
playwright-report/
test-results/
