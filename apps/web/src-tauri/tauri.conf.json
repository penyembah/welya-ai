{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Welya AI",
  "version": "0.2.0",
  "identifier": "id.biz.welya.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Welya AI",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "theme": "Dark",
        "backgroundColor": "#151b1d"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["welya"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "deb", "appimage"],
    "publisher": "Welya",
    "category": "Productivity",
    "shortDescription": "AI secretary for university students",
    "longDescription": "Welya reads lecturer emails, class messages and course documents, then turns them into tasks, deadlines and a planned week.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Indonesian"]
      }
    }
  }
}
