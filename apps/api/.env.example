DATABASE_URL=postgres://welya:welya@localhost:5433/welya
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL=15m
SESSION_TTL_DAYS=30
COOKIE_SECURE=false
PORT=4000
CORS_ORIGIN=http://localhost:1420,http://127.0.0.1:1420,tauri://localhost,http://tauri.localhost
# When true, verification codes / reset tokens are also returned in API responses (handy without SMTP)
DEV_EXPOSE_CODES=true
# Rate limiting: global per-IP requests/minute; set TRUST_PROXY=true behind a reverse proxy
RATE_LIMIT_MAX=300
TRUST_PROXY=false

UPLOAD_DIR=./uploads

# Azure AI Foundry (Azure OpenAI v1 Responses API). Leave empty to use the built-in rule engine.
AZURE_OPENAI_ENDPOINT=https://<resource>.services.ai.azure.com/openai/v1/responses
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
AI_TIMEOUT_MS=45000

# Transactional email via Brevo SMTP relay. Leave empty to disable sending.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Welya <no-reply@yourdomain.com>
# Public URL of the web app, used for links in emails
APP_URL=http://localhost:1420

# Proactive reminders: deadline/class reminders, daily summary, weekly review, free-time nudges (in-app + email)
REMINDER_SCHEDULER_ENABLED=true
REMINDER_TICK_SECONDS=60
WEEKLY_REVIEW_DAY=0
WEEKLY_REVIEW_TIME=19:00

# Google OAuth (Cloud Console → Credentials → OAuth client, type "Web application").
# Add BOTH redirect URIs below to the client. Enable the Gmail API, Google Calendar API and Google Tasks API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback
GOOGLE_INTEGRATION_REDIRECT_URI=http://localhost:4000/integrations/google/callback
GOOGLE_SYNC_INTERVAL_MINUTES=15
GOOGLE_SYNC_INITIAL_DELAY_SECONDS=30
